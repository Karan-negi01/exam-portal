# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings -> API page. Never commit .env.local.

# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# The "service_role" secret key (NOT the anon/public key). Server Actions use
# this to talk to Postgres directly, bypassing RLS -- keep it out of any
# NEXT_PUBLIC_ variable and out of the browser entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Platform admin login (there's no admin table -- this is the one operator account).
ADMIN_EMAIL=admin@examplatform.com
ADMIN_PASSWORD=admin123
